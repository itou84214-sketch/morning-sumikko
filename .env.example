# 実際の値を入れたファイルは .claude/.env に置く（.gitignore で除外済み）
# このファイルはキー名の雛形のみ。値は絶対にコミットしない。

# ── OpenAI ────────────────────────────────
# 日本語タイトル・概要欄の生成と15言語への翻訳に使用（gpt-4o）
OPENAI_API_KEY=

# ── X (Twitter) API v2 / OAuth 1.0a ───────
# 公開と同時刻の自動投稿に使用
# 従量課金。無料枠なし（投稿 $0.015 / URL付き投稿 $0.200 / 画像 $0.005）
X_consumer_key=
X_consumer_secret=
X_Access_token=
X_Access_secret=

# ── Google / YouTube Data API v3 ──────────
# キーではなくOAuthクライアントのJSONを使う:
#   .claude/client_secret.json  … Google Cloud Consoleで発行したクライアント
#   .claude/token.json          … 初回認証時に自動生成されるアクセストークン
# 必要なスコープ:
#   https://www.googleapis.com/auth/youtube.upload
#   https://www.googleapis.com/auth/youtube.force-ssl
